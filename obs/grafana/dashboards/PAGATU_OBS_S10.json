    {
      "id": 4,
      "title": "Peticiones HTTP por segundo",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{job=~\"pagatu-.*\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "legendFormat": "{{application}}",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "description": "Mide solicitudes registradas por Micrometer; incluye tráfico Actuator si la aplicación lo registra.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Latencia HTTP promedio (ms)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum by (application) (rate(http_server_requests_seconds_sum{job=~\"pagatu-.*\"}[5m])) / clamp_min(sum by (application) (rate(http_server_requests_seconds_count{job=~\"pagatu-.*\"}[5m])), 0.000001)",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "legendFormat": "{{application}}",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "description": "Media aritmética derivada de _sum/_count; NO es p95.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
