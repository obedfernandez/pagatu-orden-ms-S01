{
  "id": null,
  "uid": "pagatu-s10-obs",
  "title": "PAGATU — Observabilidad y Diagnóstico S10",
  "tags": [
    "pagatu",
    "s10",
    "observabilidad",
    "prometheus",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "title": "Targets UP — Pagatu",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"pagatu-.*\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "legendFormat": "Activos",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "description": "Cantidad real de endpoints que Prometheus puede consultar; no implica que todos los microservicios estén iniciados.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Targets DOWN — Pagatu",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"pagatu-.*\"} == 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "legendFormat": "Caídos",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "description": "Durante una caída de instancia registrada en Eureka, un target puede desaparecer de discovery en vez de quedar DOWN.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
