      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"pagatu-.*\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "legendFormat": "{{application}} · {{instance}}",
          "interval": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
