#!/bin/sh
set -e
MV=3.9.9
BASE="${HOME}/.m2/wrapper/dists/apache-maven-${MV}-bin"
HOME_MVN="${BASE}/apache-maven-${MV}"
if [ ! -x "${HOME_MVN}/bin/mvn" ]; then
  mkdir -p "$BASE"
  ZIP="/tmp/apache-maven-${MV}-bin.zip"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MV}/apache-maven-${MV}-bin.zip"
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$URL" -o "$ZIP"; else wget -q "$URL" -O "$ZIP"; fi
  unzip -q -o "$ZIP" -d "$BASE"
  rm -f "$ZIP"
fi
exec "${HOME_MVN}/bin/mvn" "$@"
